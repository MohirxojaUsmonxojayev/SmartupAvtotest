{
  "name": "smartup-xtrade-autotest",
  "private": true,
  "description": "SmartUp xtrade (app3.greenwhite.uz) — tungi avtotest: login (Keychain) → smoke (health) → regression (858 case) → rollar matritsasi → biznes-simulyatsiya",
  "scripts": {
    "setup": "playwright test --project=setup",
    "health": "playwright test --project=health",
    "smoke": "playwright test --project=health",
    "regression": "playwright test --project=regression --no-deps",
    "smoke+regression": "ONLY_PHASES=\"setup health regression\" bash scripts/nightly.sh",
    "access": "playwright test --project=access",
    "sim": "playwright test --project=sim",
    "nightly": "bash scripts/nightly.sh",
    "headed:sim": "playwright test --project=sim --headed --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}