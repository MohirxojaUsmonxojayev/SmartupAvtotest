// SmartUp a2 (Angular) — sahifa yordamchilari va test_cases.json «action» lug'ati bajaruvchisi.
// Selektorlar 28.09.2026 dagi DOM bo'yicha (ro'yxat: .smt-data-row, sarlavha: smt-cell-header, dialog: [role=dialog]).
const { expect } = require('@playwright/test');

// 29.09 relizidan keyin «Подбор» va ba'zi formalar cdk-overlay ichidagi drawer'da ochiladi (o'z <main> i bilan) — oxirgi <main> = eng ustki oyna
const main = (page) => page.locator('main').last();
const esc = (x) => String(x).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const YES = /^\s*(Да|Вкл\.)\s*$/i; // «Вкл.» — ma'lum bug (SPR-003/OBR-001/PRZ-003): tasdiq tugmasi shunday yozilgan

async function idle(page, ms = 600) {
  await page.waitForLoadState('networkidle', { timeout: 15000 }).catch(() => {});
  await page.waitForTimeout(ms);
}

// ---------------------------------------------------------------- login va filial
async function login(page, baseURL, loginName, password) {
  await page.goto(baseURL + '/xtrade/login.html');
  await page.locator('#login').fill(loginName);
  await page.locator('#password').fill(password);
  await page.locator('#sign_in').click();
  await page.waitForURL((u) => !/login\.html/.test(u.toString()), { timeout: 45000 });
  await idle(page, 2000);
}
async function currentFilial(page) {
  const t = await page.locator('body').innerText().catch(() => '');
  return (t.match(/TRADE\s*\n?\s*(\S+)/) || [])[1] || '';
}
async function switchFilial(page, name) {
  if ((await currentFilial(page)) === name) return name;
  await page.locator('.dropdown-locations-custom').first().click();
  await page.waitForTimeout(1500);
  const items = page.locator('.filial-list a, .filial-list li, .filial-list div').filter({ hasText: new RegExp('^\\s*' + esc(name) + '\\s*$') });
  await items.last().click();
  await idle(page, 4000);
  return currentFilial(page);
}
async function isLoginPage(page) {
  return /login\.html/.test(page.url()) || (await page.locator('#password').count()) > 0;
}

// ---------------------------------------------------------------- kuzatuvchilar (tarmoq, konsol)
function attachCollectors(page) {
  const net = [];
  const cons = [];
  page.on('response', (r) => {
    const u = r.url(); const s = r.status();
    if (s >= 500 || (s >= 400 && /\/xtrade\/b\//.test(u)) || (s === 404 && /i18n/.test(u))) net.push({ s, u: u.split('?')[0].replace(/^https?:\/\/[^/]+/, '') });
  });
  page.on('pageerror', (e) => cons.push(String(e.message).slice(0, 200)));
  page.on('console', (m) => { if (m.type() === 'error') cons.push(m.text().slice(0, 200)); });
  return { net, cons, reset() { net.length = 0; cons.length = 0; } };
}

// Tarjima qilinmagan kalitlar: faqat sarlavha/yorliq/tugma matnlarida (qator ma'lumotlarida emas)
async function untranslated(page) {
  const texts = await main(page).locator('smt-cell-header, label, button, h1, h2, [role=tab]').allInnerTexts().catch(() => []);
  const out = new Set();
  for (const t of texts) for (const m of t.matchAll(/\b(UI-[A-Z0-9]+:[\w .-]+|[a-z]{2,}(?:_[a-z]+)+|table\.[a-z_]+)\b/g)) out.add(m[1]);
  return [...out].slice(0, 10);
}
async function snapshot(page) {
  const m = main(page);
  const txt = await m.innerText().catch(() => '');
  return {
    title: txt.split('\n').map((x) => x.trim()).filter(Boolean)[0] || '',
    heads: (await m.locator('smt-cell-header').allInnerTexts().catch(() => [])).map((x) => x.trim()).filter(Boolean),
    btns: [...new Set((await m.locator('button:visible').allInnerTexts().catch(() => [])).map((x) => x.trim()).filter((x) => x && x.length < 40))],
    labels: [...new Set((await m.locator('label:visible').allInnerTexts().catch(() => [])).map((x) => x.replace(/\s+/g, ' ').trim()).filter((x) => x && x.length < 70))],
    counter: (txt.match(/\b\d+\/\d+\b/) || [''])[0],
    failed: /Не удалось загрузить/.test(txt),
    errDialogs: (await page.locator('[role=dialog]').filter({ hasText: /Ошибка|Не удалось|ORA-|violated|Exception/i }).allInnerTexts().catch(() => [])).map((x) => x.replace(/\s+/g, ' ').slice(0, 300)),
    keys: await untranslated(page),
  };
}
async function closeDialogs(page) {
  for (const b of await page.locator('[role=dialog] button').filter({ hasText: /^(\s*)(Закрыть|Нет|ОК|Ok|Выкл\.)(\s*)$/i }).all()) await b.click().catch(() => {});
}
async function rowActions(page) {
  const row = main(page).locator('.smt-data-row:visible').first();
  if (!(await row.count())) return null;
  const cells = row.locator('.text-start');
  await ((await cells.count()) > 1 ? cells.nth(1) : row).click();
  await page.waitForTimeout(1200);
  const box = await row.boundingBox();
  const acts = [];
  for (const b of await page.locator('button:visible').all()) {
    const bb = await b.boundingBox();
    if (bb && box && bb.y >= box.y - 2 && bb.y < box.y + box.height + 70) acts.push((await b.innerText()).trim());
  }
  return acts.filter(Boolean);
}
function btn(page, text, scope) {
  return (scope || page).locator('button:visible, a:visible, [role=menuitem]:visible, [role=option]:visible').filter({ hasText: new RegExp('^\\s*' + esc(text) + '\\s*$', 'i') }).first();
}
// Ochiq drawer/dialog bo'lsa — avval undagi tugma (sahifa va drawer'da bir xil «Закрыть» bor)
// 29.09 relizida ba'zi nomlar o'zgardi (Просмотреть→Просмотр, Создать→Добавить) — topilmasa muqobil nom sinab ko'riladi
const ALIAS = { 'Просмотреть': 'Просмотр', 'Просмотр': 'Просмотреть', 'Создать': 'Добавить', 'Добавить': 'Создать' };
async function btnTop(page, text) {
  for (const t of [text, ALIAS[text]].filter(Boolean)) {
    const ov = btn(page, t, page.locator('.cdk-overlay-container'));
    if (await ov.count()) return ov;
    const pg = btn(page, t);
    if (await pg.count()) return pg;
  }
  return btn(page, text);
}

// ---------------------------------------------------------------- «action» lug'ati (test_cases.json bilan bir xil)
function field(page, label) {
  const clean = String(label).replace(/\s*\*$/, '').replace(/\(.*?\)\s*$/, '').trim();
  return page.locator('label').filter({ hasText: clean }).first()
    .locator('xpath=ancestor::*[.//input or .//textarea or .//smt-select-trigger or .//smt-data-select or .//*[@role="switch"]][1]');
}
// Salbiy qadam: kutilgan natija rad etish/xabar bo'lsa, xato oynasi — to'g'ri natija (kod mos kelishi tekshiriladi)
function expectsError(s) { return /rad etiladi|xato xabari|xabar chiqadi|H0\d-|Ошибка|saqlanmaydi|yaratilmaydi/i.test((s && s.expected) || ''); }
async function failOnErrorDialog(page, s) {
  const dlg = page.locator('[role=dialog]').filter({ hasText: /Ошибка|Не удалось загрузить|violated|Exception/i });
  if (!(await dlg.count())) return false;
  const txt = (await dlg.first().innerText()).replace(/\s+/g, ' ').slice(0, 400);
  if (s && expectsError(s) && !/violated|ORA-|Exception|dup_val|Z:#/i.test(txt)) {
    const code = /(H0\d-[A-Z]+\d+-\d+)/.exec(s.expected || '');
    if (code && !txt.includes(code[1])) throw new Error(`Kutilgan xato kodi ${code[1]} emas: ${txt}`);
    await closeDialogs(page);
    return true;
  }
  throw new Error('Xato oynasi: ' + txt);
}
const A = {
  async nav(page, s) {
    const url = s.value && !String(s.value).includes('<') ? s.value : null;
    if (url) await page.goto(url);
    else {
      const parts = String(s.target).split('>').map((x) => x.trim());
      await page.getByText(parts[0], { exact: true }).first().click();
      await page.getByText(parts[parts.length - 1], { exact: true }).first().click();
    }
    await idle(page, 1500);
    await failOnErrorDialog(page);
  },
  async open_url(page, s) { await page.goto(s.target); await idle(page, 1500); },
  async click(page, s) {
    await (await btnTop(page, s.target)).click();
    const conf = /^confirm:(.+)\|(.+)$/.exec(s.value || '');
    await idle(page, 800);
    if (conf) await A.confirm(page, { target: conf[1], value: conf[2] }).catch(async (e) => {
      // «Сохранить?» so'ralmasligi ham mumkin — dialog yo'q bo'lsa davom; salbiy qadamda kutilgan xato oynasi — to'g'ri
      if (await failOnErrorDialog(page, s)) return;
      if (await page.locator('[role=dialog]').count()) throw e;
    });
  },
  async row_click(page, s) {
    const tgt = String(s.target).replace(/[«»]/g, '').trim();
    const row = /^birinchi qator/i.test(tgt) ? main(page).locator('.smt-data-row:visible').first()
      : main(page).locator('.smt-data-row').filter({ hasText: tgt }).first();
    await row.waitFor({ timeout: 15000 });
    const cells = row.locator('.text-start');
    await ((await cells.count()) > 1 ? cells.nth(1) : row).click();
    await page.waitForTimeout(1000);
  },
  async row_action(page, s) { await (await btnTop(page, s.target)).click(); await idle(page, 1500); },
  async fill(page, s) { await field(page, s.target).locator('input, textarea').first().fill(String(s.value)); },
  async fill_date(page, s) {
    const f = field(page, s.target).locator('input').first();
    await f.click(); await f.press('ControlOrMeta+A'); await f.pressSequentially(String(s.value), { delay: 40 }); await f.press('Tab');
  },
  async select(page, s) {
    const f = field(page, s.target);
    const trg = f.locator('smt-select-trigger');
    await ((await trg.count()) ? trg.first() : f.locator('smt-data-select, smt-multi-data-select, input').first()).click();
    await page.keyboard.type(String(s.value), { delay: 30 });
    const opt = page.locator('.cdk-overlay-pane').getByText(String(s.value)).first();
    await opt.waitFor({ timeout: 10000 });
    await opt.click();
    await page.waitForTimeout(600);
  },
  async multiselect(page, s) {
    for (const v of String(s.value).split(',').map((x) => x.trim())) await A.select(page, { target: s.target, value: v });
    await page.keyboard.press('Escape');
  },
  async toggle(page, s) {
    const sw = field(page, s.target).locator('[role=switch], [role=checkbox], input[type=checkbox]').first();
    const on = (await sw.getAttribute('aria-checked')) === 'true' || (await sw.isChecked().catch(() => false));
    if ((s.value === 'on') !== on) await sw.click();
  },
  async radio(page, s) { await field(page, s.target).getByText(s.value, { exact: true }).click(); },
  async tab(page, s) { await page.getByRole('tab', { name: s.target }).first().click().catch(() => btn(page, s.target).click()); await idle(page, 800); },
  async grid_fill(page, s) {
    const [rowTxt, col] = String(s.target).split('|').map((x) => x.trim());
    const grid = main(page).locator('.smt-data-row').first().locator('xpath=ancestor::*[.//smt-cell-header][1]');
    const headers = (await grid.locator('smt-cell-header').allInnerTexts()).map((h) => h.trim());
    const idx = headers.findIndex((h) => h.startsWith(col));
    const row = grid.locator('.smt-data-row').filter({ hasText: rowTxt }).first();
    const cell = row.locator(':scope > *').nth(idx);
    await cell.click(); await cell.locator('input').fill(String(s.value)); await page.keyboard.press('Tab');
  },
  async pick(page, s) {
    const [col, qty] = String(s.value).split('=');
    await A.click(page, { target: 'Подбор' });
    await A.grid_fill(page, { target: `${s.target} | ${col}`, value: qty });
    await A.click(page, { target: 'Закрыть' });
    await A.confirm(page, { target: 'Выбрать ТМЦ', value: 'Да' });
  },
  async confirm(page, s) {
    const dlg = page.locator('[role=dialog]').filter({ hasText: String(s.target).split('"')[0].replace(/[«»]/g, '').trim().slice(0, 20) }).first();
    await dlg.waitFor({ timeout: 10000 });
    const want = /^да$/i.test(s.value || 'Да') ? YES : new RegExp('^\\s*' + esc(s.value) + '\\s*$', 'i');
    await dlg.locator('button').filter({ hasText: want }).first().click();
    await idle(page, 1500);
  },
  async dialog_close(page, s) { await page.locator('[role=dialog]').locator('button').filter({ hasText: s.target || 'Закрыть' }).first().click(); },
  async sequence(page, s, ctx) { for (const op of s.ops || []) await run(page, op, ctx); },
  async assert_text(page, s) {
    if (!s.value) return;
    const T = (await main(page).innerText()).replace(/\s+/g, ' ');
    const items = String(s.value).replace(/\([^)]*\)/g, '').split(',').flatMap((x) => x.split(' / ')).map((x) => x.replace(/\s+/g, ' ').replace(/[«»"]/g, '').replace(/\s*\*$/, '').trim()).filter((x) => x && x.length < 60 && !/yo'q|\.\.\.|…/.test(x));
    const miss = items.filter((x) => !T.includes(x));
    if (miss.length) throw new Error('matn yo\'q: ' + miss.slice(0, 6).join(', '));
  },
  async assert_row(page, s) {
    const cells = String(s.value).split('|').map((x) => x.trim()).filter((x) => x && x !== '…' && !x.startsWith('<') && !/\d{2}\.\d{2}\.\d{4}/.test(x));
    let row = main(page).locator('.smt-data-row');
    for (const c of cells.slice(0, 3)) row = row.filter({ hasText: c });
    await expect(row.first()).toBeVisible({ timeout: 15000 });
  },
  async assert_field(page, s) { await expect(field(page, s.target)).toContainText(String(s.value)); },
  async assert_columns(page, s) {
    const h = (await main(page).locator('smt-cell-header').allInnerTexts()).map((x) => x.trim());
    for (const c of String(s.value).split(',').map((x) => x.trim()).slice(0, 5)) expect.soft(h.join('|')).toContain(c);
  },
  async assert_buttons(page, s) {
    for (const b of String(s.value).split(',').map((x) => x.trim()).filter((x) => x && !/yo'q/.test(x))) await expect.soft(btn(page, b)).toBeVisible();
  },
  async assert_url(page, s) { await expect(page).toHaveURL(new RegExp(esc(s.target))); },
  async wait(page, s) { await page.waitForTimeout(Number(s.value || 1) * 1000); },
  async observe() {},
  async assert_value(page, s) { return A.assert_field(page, s); },
  async assert_disabled(page, s) { await expect(btn(page, s.target)).toBeDisabled(); },
  // tarmoq tekshiruvi: ctx.col — attachCollectors() natijasi (case boshida reset qilinadi)
  async assert_api(page, s, ctx) {
    const net = (ctx && ctx.col && ctx.col.net) || [];
    if (/i18n/.test(String(s.target))) {
      const f = net.filter((x) => x.s === 404 && /i18n/.test(x.u));
      if (f.length) throw new Error('i18n 404: ' + f.map((x) => x.u.split('/').pop()).join(', '));
      return;
    }
    const bad = net.filter((x) => x.s >= 500 || (x.s >= 400 && /\/b\//.test(x.u)));
    if (bad.length) throw new Error('HTTP ' + bad.map((x) => x.s + ' ' + x.u).slice(0, 3).join('; '));
  },
};
async function run(page, s, ctx) {
  const fn = A[s.action];
  if (!fn) throw new Error(`«${s.action}» avtomatlashtirilmagan: ${s.description || s.target}`);
  await fn(page, s, ctx);
}

module.exports = { main, esc, idle, btnTop, login, switchFilial, currentFilial, isLoginPage, attachCollectors, snapshot, untranslated, closeDialogs, rowActions, btn, field, failOnErrorDialog, expectsError, A, run, YES };
