# .env NAMUNASI — nusxa oling: cp .env.example .env, keyin qiymatlarni to'ldiring.
# Haqiqiy .env git'ga kirmaydi (.gitignore). Bu faylga HAQIQIY parol yozmang.

# Telegram bot
TELEGRAM_BOT_TOKEN=<bot_token>
TELEGRAM_CHAT_ID=<chat_id>

# Test brauzeri: 1=headless (CI), 0=headed (lokal)
HEADLESS=0

# DEFAULT login/parollar (CI'da bular GitHub Secrets'dan keladi)
ONLINE_LOGIN=alibe@test
ONLINE_PASSWORD=<online_default_parol>
XTRADE_LOGIN=moxir@novatrade
XTRADE_PASSWORD=<xtrade_default_parol>

# (ixtiyoriy) admin profillari
ONLINE_ADMIN_LOGIN=admin@test
ONLINE_ADMIN_PASSWORD=<online_admin_parol>
XTRADE_ADMIN_LOGIN=admin@novatrade
XTRADE_ADMIN_PASSWORD=<xtrade_admin_parol>
